rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Simplified admin check for this applet environment
      // In production, we'd check a dedicated 'admins' collection
      return isSignedIn() && (
        request.auth.token.email == 'sportsarslan199@gmail.com' ||
        request.auth.token.email == 'worldmarketsupport@gmail.com'
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Product Validation ---
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200
          && data.price is number && data.price >= 0
          && data.category is string && data.category.size() > 0
          && data.image is string && data.image.size() > 0;
    }

    match /products/{productId} {
      allow read, list: if true; // Public catalog
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // --- Sale Record Validation ---
    function isValidSale(data) {
      return data.customerName is string && data.customerName.size() > 0
          && data.amount is number && data.amount >= 0
          && data.status in ['New Order', 'Processing', 'Shipped', 'Delivered', 'Cancelled', 'Pending Payment', 'Confirmed', 'Completed']
          && (data.sellerId == null || data.sellerId is string);
    }

    match /sales/{saleId} {
      allow create: if isValidSale(incoming()) && isValidId(saleId);
      allow read, list: if true; 
      allow update: if isAdmin() || (incoming().diff(existing()).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    // --- Seller Validation ---
    function isValidSeller(data) {
      return data.fullName is string && data.fullName.size() > 0
          && data.showName is string && data.showName.size() > 0
          && data.email is string && data.email.size() > 0;
    }

    match /sellers/{sellerId} {
      allow read, list: if true; // Profile is public for routing
      allow create: if isValidSeller(incoming()) && isValidId(sellerId);
      allow update: if isAdmin() || true;
      allow delete: if isAdmin();
    }

    // --- Seller Earnings ---
    function isValidEarning(data) {
      return data.sellerId is string && data.sellerId.size() > 0
          && data.orderId is string && data.orderId.size() > 0
          && data.amount is number && data.amount > 0
          && data.createdByAdminEmail is string;
    }

    match /sellerEarnings/{earningId} {
      allow read, list: if true;
      allow create: if isAdmin() && isValidEarning(incoming()) && isValidId(earningId);
      allow update, delete: if isAdmin();
    }

    // --- Seller Payouts ---
    function isValidPayout(data) {
      return data.sellerId is string && data.sellerId.size() > 0
          && data.amount is number && data.amount > 0
          && data.payoutDate is string
          && data.paymentMethod is string
          && data.status in ['Paid', 'Reversed']
          && data.createdByAdminEmail is string;
    }

    match /sellerPayouts/{payoutId} {
      allow read, list: if true;
      allow create: if isAdmin() && isValidPayout(incoming()) && isValidId(payoutId);
      allow update: if isAdmin();
      allow delete: if false; // Audit trail is never silently deleted
    }

    // --- Notifications ---
    function isValidNotification(data) {
      return data.type in ['New Order', 'New Seller', 'Payment Request', 'Stock Alert', 'Payout Paid']
          && data.title is string && data.title.size() > 0
          && data.targetRole in ['admin', 'seller'];
    }

    match /notifications/{notificationId} {
      allow create: if isValidNotification(incoming()) && isValidId(notificationId);
      allow read, list: if true;
      allow update: if isAdmin() || (incoming().diff(existing()).affectedKeys().hasOnly(['isRead']));
      allow delete: if isAdmin();
    }
  }
}
